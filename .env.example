# ============================================================
# Maranatha Le Juste Prix — configuration du serveur
# Copier ce fichier en « .env » puis compléter.
# Ne jamais versionner le .env : il contient des secrets.
# ============================================================

# --- Où vivent les données (doit survivre à un redéploiement) ---
DATA_DIR=./data
# DATABASE_PATH=./data/maranatha.db
# UPLOADS_DIR=./data/uploads
# IMPORTS_DIR=./data/imports

# --- Signature des sessions ---
# Obligatoire en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=30

# --- Premier compte, créé au démarrage s'il n'existe aucun compte ---
# Le mot de passe devra être changé à la première connexion.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# --- Livraison (réglable ensuite dans le back-office) ---
DELIVERY_FEE=1000
FREE_DELIVERY_FROM=50000

# --- Paiement mobile : CinetPay (MTN MoMo, Orange Money, cartes) ---
# Laisser CINETPAY_ENABLED=false tant que le compte marchand n'est pas ouvert.
# La boutique fonctionne sans : paiement à la livraison et en boutique.
CINETPAY_ENABLED=false
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=

# --- Photos du catalogue : Cloudflare R2 (facultatif) ---
# Laisser vide range les photos sur le disque du serveur, dans DATA_DIR.
# C'est le mode par défaut et il suffit pour une boutique.
#
# Renseigné, les photos partent sur R2 et sont servies par le réseau de
# Cloudflare : elles ne passent plus par le serveur, l'egress est gratuit,
# et elles survivent à un redéploiement même sans volume.
#
# Après avoir rempli ces valeurs sur une boutique qui tourne déjà, lancer
# une fois :  node scripts/outil.mjs photos-vers-r2 --vrai
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Déduit de R2_ACCOUNT_ID si laissé vide.
R2_ENDPOINT=
# Dossier dans le bucket, pour cohabiter avec d'autres projets.
R2_PREFIX=maranatha
# Domaine public du bucket. Vide, les photos transitent par le serveur.
R2_PUBLIC_URL=

# --- Numéro recevant les commandes WhatsApp (format international, sans +) ---
WHATSAPP_NUMBER=237675201251

# --- Adresse publique du site (pour les retours de paiement) ---
PUBLIC_URL=https://maranatha-le-juste-prix.com
