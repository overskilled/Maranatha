# Dependencies
node_modules/

# Build output and caches (regenerated by `npm run build`)
dist/
.astro/

# Original photos — already processed into public/images and unused by the build
images-src/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Données d'exécution : base SQLite, photos produits, fichiers d'import.
# Vivent dans un volume, jamais dans le dépôt.
# La barre oblique initiale ancre le motif à la racine : sans elle,
# « src/data » serait ignoré lui aussi.
/data/
