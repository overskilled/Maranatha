---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list" data-reveal>
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <div class="faq-item__body">{item.answer}</div>
      </details>
    ))
  }
</div>
