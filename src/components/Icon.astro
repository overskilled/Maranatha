---
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'plus'
    | 'minus'
    | 'close'
    | 'menu'
    | 'phone'
    | 'whatsapp'
    | 'mail'
    | 'pin'
    | 'clock'
    | 'check'
    | 'chevron-down'
    | 'download';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.5, class: className } = Astro.props;

const strokePaths: Record<string, string> = {
