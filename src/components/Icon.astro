  menu: '<path d="M3.5 8.5h17M3.5 15.5h17"/>',
  phone:
    '<path d="M7.1 3.5H4.4c-.7 0-1.2.6-1.1 1.3.6 4.5 2.8 8.6 6 11.4 2.8 2.5 6.2 4.1 9.9 4.5.7.1 1.3-.5 1.3-1.2v-2.7c0-.6-.4-1.1-1-1.2l-3.2-.6c-.5-.1-1 .1-1.3.5l-1 1.3a14.6 14.6 0 0 1-4.8-4.5l1.4-1c.5-.3.7-.9.5-1.4l-1.2-3c-.2-.5-.7-.8-1.2-.8Z"/>',
