---
import { site } from '../data/site';
import { divisions } from '../data/divisions';
import Icon from './Icon.astro';
import BrandLockup from './BrandLockup.astro';
import Seal from './Seal.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top shell">
    <p class="eyebrow">Bafoussam · Cameroun</p>
    <p class="footer__tag scripture">{site.tagline}</p>
    <a class="footer__top-link" href="/devis">
      Demander un devis
      <Icon name="arrow-up-right" size={15} />
    </a>
  </div>

  <div class="footer__main shell">
    <div class="footer__brand">
      <a href="/" aria-label={`${site.name}, accueil`}>
        <BrandLockup variant="stacked" />
      </a>
      <p class="footer__promise">
        Des prix justes.<br />
        Une parole tenue.
      </p>
      <p class="footer__legal-name">{site.legalName}</p>
    </div>

    <nav class="footer__col" aria-label="Activités">
      <p class="label">Les métiers</p>
      <ul>
        {
          divisions.map((division) => (
            <li>
              <a href={`/${division.slug}`}>
                <span>{division.number}</span>
                {division.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-label="La maison">
      <p class="label">La maison</p>
      <ul>
        <li><a href="/la-maison">Qui nous sommes</a></li>
        <li><a href="/le-juste-prix">Nos engagements</a></li>
        <li><a href="/carnet">Le carnet</a></li>
        <li><a href="/contact">Nous contacter</a></li>
        <li><a href="/devis">Demander un devis</a></li>
      </ul>
    </nav>

    <div class="footer__col footer__contact">
      <p class="label">Nous joindre</p>
      <ul>
        <li class="footer__contact-row">
          <Icon name="pin" size={15} />
          <span>{site.address}</span>
        </li>
        <li class="footer__contact-row">
          <Icon name="phone" size={15} />
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </li>
        <li class="footer__contact-row">
          <Icon name="whatsapp" size={15} />
          <a href={site.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </li>
        <li class="footer__contact-row">
          <Icon name="mail" size={15} />
          <a href={site.emailHref}>{site.email}</a>
        </li>
        <li class="footer__contact-row">
          <Icon name="clock" size={15} />
          <span>{site.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__mark shell" aria-hidden="true">
    <span class="footer__mark-word">Maranatha</span>
    <span class="footer__seal"><Seal /></span>
  </div>

  <div class="footer__bottom shell">
    <p>© {year} {site.legalName}. Tous droits réservés.</p>
    <p class="footer__verse">
      <span class="label">Proverbes 11:1</span>
      « La balance fausse est en horreur à l'Éternel, mais le poids juste lui est agréable. »
    </p>
    <p class="footer__maranatha">Maranatha, le Seigneur vient.</p>
  </div>

  <div class="footer__sub shell">
    <nav aria-label="Informations légales">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
      <a href="/credits-photo">Crédits photo</a>
    </nav>
    <p>Bafoussam, Région de l'Ouest, Cameroun</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background-color: var(--night-deep);
    background-image: radial-gradient(rgba(246, 240, 226, 0.16) 0.6px, transparent 0.6px);
    background-size: 42px 42px;
    color: var(--ivory);
    padding-top: clamp(3rem, 6vw, 5.5rem);
  }

  .footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 14, 25, 0.2), var(--night-deep) 65%);
    pointer-events: none;
  }

  .footer > * {
    position: relative;
    z-index: 1;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--hair-light);
  }

  .footer__top .eyebrow {
    color: var(--ivory-muted);
  }

  .footer__tag {
    text-align: center;
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
    color: var(--gold);
  }

  .footer__top-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ivory);
    border-bottom: 1px solid var(--hair-gold);
    padding-bottom: 0.35rem;
  }

  .footer__top-link:hover {
    color: var(--gold);
  }

  .footer__main {
    display: grid;
    grid-template-columns: 2.4fr 1.1fr 1fr 1.6fr;
    gap: clamp(2rem, 4vw, 4.5rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .footer__brand :global(.lockup) {
    vertical-align: middle;
  }

  .footer__promise {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    line-height: 1.15;
    color: var(--ivory);
  }

  .footer__legal-name {
    margin-top: 1.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ivory-muted);
  }

  .footer__col .label {
    color: var(--gold);
    margin-bottom: 1.1rem;
  }

  .footer__col ul {
    display: grid;
    gap: 0.55rem;
    font-size: 0.92rem;
    color: var(--ivory-muted);
  }

  .footer__col a {
    transition: color 0.2s ease;
  }

  .footer__col a:hover {
    color: var(--gold);
  }

  .footer__col li span {
    display: inline-block;
    width: 1.7rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  .footer__contact ul {
    gap: 0.8rem;
  }

  .footer__contact-row {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.55rem;
    align-items: start;
    line-height: 1.45;
  }

  .footer__contact-row svg {
    margin-top: 0.18rem;
    color: var(--gold);
  }

  .footer__contact .footer__contact-row span {
    width: auto;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  .footer__mark {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--hair-light);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer__mark-word {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(4.2rem, 15.3vw, 14.5rem);
    line-height: 0.72;
    letter-spacing: -0.045em;
    color: var(--ivory);
    white-space: nowrap;
  }

  .footer__seal {
    display: block;
    width: clamp(84px, 10vw, 136px);
    flex: 0 0 auto;
    opacity: 0.9;
    margin-bottom: 0.4rem;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--hair-light);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--ivory-muted);
  }

  .footer__verse {
    text-align: center;
    max-width: 46ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-style: italic;
    line-height: 1.35;
    color: rgba(246, 240, 226, 0.78);
  }

  .footer__verse .label {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--gold);
    font-family: var(--font-text);
    font-style: normal;
  }

  .footer__maranatha {
    justify-self: end;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer__sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem 1.7rem;
    border-top: 1px solid rgba(246, 240, 226, 0.08);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: rgba(246, 240, 226, 0.45);
  }

  .footer__sub nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .footer__sub a:hover {
    color: var(--gold);
  }

  @media (max-width: 1080px) {
    .footer__main {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .footer__contact {
      grid-column: 1 / -1;
      padding-top: 1.5rem;
      border-top: 1px solid var(--hair-light);
    }

    .footer__contact ul {
      grid-template-columns: 1fr 1fr;
      display: grid;
      gap: 0.8rem 2rem;
    }
  }

  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .footer__tag {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: left;
    }

    .footer__top-link {
      justify-self: end;
    }

    .footer__main {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .footer__verse,
    .footer__maranatha {
      justify-self: start;
      text-align: left;
      margin-inline: 0;
    }
  }

  @media (max-width: 560px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .footer__contact {
      grid-column: auto;
    }

    .footer__contact ul {
      grid-template-columns: 1fr;
    }

    .footer__mark {
      align-items: flex-end;
    }

    .footer__mark-word {
      font-size: clamp(3.3rem, 17.5vw, 6rem);
    }

    .footer__seal {
      display: none;
    }

    .footer__sub {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
  }
</style>
