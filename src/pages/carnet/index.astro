---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CTABand from '../../components/CTABand.astro';
import Figure from '../../components/Figure.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { articles } from '../../data/articles';

const featured = articles[0];
const rest = articles.slice(1);

const themes = [
  {
    number: '01',
    title: 'Comprendre un prix',
    text: "Ce qui compose un prix, ce qui le fait changer et ce qui devrait rester écrit. Des notes pour acheter avec les yeux ouverts.",
    href: '/carnet/le-prix-affiche-est-le-prix-paye',
    link: 'Lire sur le prix affiché',
  },
  {
    number: '02',
    title: 'Choisir et vérifier',
    text: "Les questions à poser à un fournisseur, les documents à garder et les signaux qui méritent un second regard.",
    href: '/carnet/acheter-en-gros-a-bafoussam',
    link: 'Lire la checklist gros',
  },
  {
    number: '03',
    title: 'La maison, sans posture',
    text: "Ce que signifie notre nom, ce que nous refusons et ce que nous essayons de tenir dans les jours ordinaires.",
    href: '/carnet/maranatha-ce-que-le-mot-veut-dire',
    link: 'Lire sur le nom',
  },
];
---

<BaseLayout
  title="Le carnet"
  description="Notes de terrain de Maranatha Le Juste Prix : prix, achats en gros, import-export et vie de la maison. Des textes courts et concrets, sans vernis."
>
  <PageHero
    index="04"
    label="Le carnet"
    title="Notes de terrain, <em>sans vernis.</em>"
    lede="Des textes courts sur les prix, les achats, la route et la manière de tenir une parole. Ce que nous apprenons au comptoir, nous l'écrivons ici."
    image="hero-market"
    imageAlt="Scène de marché avec vendeurs et chalands"
    imageCaption="Le marché, là où les prix se disent et se vérifient."
    imagePosition="50% 45%"
    meta={[
      { label: 'Format', value: 'Notes · Guides · Récits' },
      { label: 'Rythme', value: 'Quelques textes par saison' },
      { label: 'Auteur', value: 'La maison Maranatha' },
    ]}
    primary={{ label: 'Lire la dernière note', href: `/carnet/${featured.slug}` }}
    secondary={{ label: 'Nous écrire', href: '/contact' }}
  />

  <section class="page-section page-section--tight">
    <div class="shell carnet-lead">
      <p class="eyebrow" data-reveal>La une</p>
      <div class="carnet-lead__row" data-reveal>
        <h2>Ce que nous apprenons <em>en travaillant.</em></h2>
        <p>
          Le carnet n'est pas un blog d'actualités. C'est un endroit pour poser noir sur blanc ce
          qu'une maison de commerce apprend de ses clients, de ses fournisseurs et de ses routes.
        </p>
      </div>
    </div>
  </section>

  <section class="page-section page-section--tight">
    <div class="shell">
      <a class="journal-feature" href={`/carnet/${featured.slug}`} data-reveal>
        <span class="journal-feature__media">
          <Figure
            name={featured.image}
            alt={featured.imageAlt}
            sizes="(max-width: 900px) 100vw, 58vw"
            loading="eager"
          />
        </span>
        <span class="journal-feature__copy">
          <span class="journal-feature__meta">
            <span>{featured.category}</span>
            <span>{featured.date}</span>
            <span>{featured.readTime} de lecture</span>
          </span>
          <h2>{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <span class="link-arrow">
            Lire la note
            <Icon name="arrow-right" size={14} />
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="page-section page-section--ivory-soft">
    <div class="shell">
      <SectionHead
        index="02"
        label="Dernières notes"
        title="Trois manières <em>de regarder le travail.</em>"
        intro="Chaque texte part d'une situation concrète. Aucun ne prétend remplacer un échange sur votre dossier."
      />

      <div class="journal-grid" data-reveal-group>
        {
          rest.map((article) => (
            <article class="article-card">
              <a class="article-card__media img-zoom" href={`/carnet/${article.slug}`} aria-label={article.title}>
                <Figure
                  name={article.image}
                  alt={article.imageAlt}
                  sizes="(max-width: 720px) 100vw, 32vw"
                />
              </a>
              <div class="article-card__meta">
                <span>{article.category}</span>
                <span>{article.date}</span>
                <span>{article.readTime}</span>
              </div>
              <h3><a href={`/carnet/${article.slug}`}>{article.title}</a></h3>
              <p>{article.excerpt}</p>
              <a class="link-arrow" href={`/carnet/${article.slug}`}>
                Lire
                <Icon name="arrow-right" size={14} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell carnet-themes">
      <div class="carnet-themes__intro" data-reveal>
        <p class="eyebrow">Les thèmes</p>
        <h2>Trois fils, <em>une même maison.</em></h2>
        <p>
          Le prix, la vérification et la parole. Ces trois fils traversent nos métiers et nos
          décisions. Le carnet les suit sans chercher à les rendre spectaculaires.
        </p>
        <div class="actions">
          <Button href="/contact" variant="dark" arrow="arrow-up-right">Proposer un sujet</Button>
        </div>
      </div>

      <div class="theme-list" data-reveal-group>
        {
          themes.map((theme) => (
            <a class="theme-row" href={theme.href}>
              <span class="theme-row__num">{theme.number}</span>
              <div>
                <h3>{theme.title}</h3>
                <p>{theme.text}</p>
                <span class="theme-row__link">
                  {theme.link}
                  <Icon name="arrow-up-right" size={14} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand
    variant="dawn"
    eyebrow="Une question après lecture ?"
    title="Écrivez-nous."
    text="Le carnet ne remplace pas une réponse adaptée à votre situation. Si un texte soulève une question sur votre commande, votre chantier ou votre approvisionnement, nous pouvons en parler."
    primaryLabel="Nous contacter"
    primaryHref="/contact"
    secondaryLabel="Demander un devis"
    secondaryHref="/devis"
  />
</BaseLayout>

<style>
  .carnet-lead {
    display: grid;
    gap: 1.5rem;
  }

  .carnet-lead__row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-top: 1rem;
    border-top: 1px solid var(--hair-dark);
  }

  .carnet-lead__row h2 {
    max-width: 16ch;
    font-size: clamp(2.4rem, 1.5rem + 3vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .carnet-lead__row h2 :global(em) {
    color: var(--gold-deep);
    font-style: normal;
    font-weight: 500;
  }

  .carnet-lead__row p {
    max-width: 42ch;
    justify-self: end;
    padding-top: 1rem;
    border-top: 1px solid var(--hair-dark);
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--ink-muted);
  }

  .carnet-themes {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .carnet-themes__intro {
    position: sticky;
    top: 110px;
  }

  .carnet-themes__intro h2 {
    max-width: 13ch;
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .carnet-themes__intro h2 :global(em) {
    color: var(--gold-deep);
    font-style: normal;
    font-weight: 500;
  }

  .carnet-themes__intro > p {
    max-width: 40ch;
    margin-top: 1.1rem;
    font-size: 0.96rem;
    line-height: 1.68;
    color: var(--ink-muted);
  }

  .carnet-themes__intro .actions {
    margin-top: 1.5rem;
  }

  .theme-list {
    border-top: 1px solid var(--hair-dark);
  }

  .theme-row {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.3rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--hair-dark);
    transition: background-color 0.3s ease;
  }

  .theme-row:hover {
    background: var(--gold-wash);
  }

  .theme-row__num {
    padding-top: 0.35rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--gold-deep);
  }

  .theme-row h3 {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.1rem);
    line-height: 1.06;
  }

  .theme-row p {
    max-width: 54ch;
    margin-top: 0.55rem;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .theme-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  @media (max-width: 900px) {
    .carnet-lead__row {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .carnet-lead__row p {
      justify-self: start;
    }

    .carnet-themes {
      grid-template-columns: 1fr;
    }

    .carnet-themes__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .carnet-lead__row h2 {
      font-size: 2.4rem;
    }

    .theme-row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
  }
</style>
