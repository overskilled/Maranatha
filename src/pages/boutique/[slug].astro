---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import '../../styles/shop.css';
import { getProductBySlug, listProducts } from '../../lib/repo/products';
import { getSettings } from '../../lib/settings';
import { formatAmount, formatShort } from '../../lib/money';
import { imageUrl, imageSrcset } from '../../lib/images';
import { site } from '../../data/site';
import { truncate } from '../../lib/text';

const { slug } = Astro.params;
const product = await getProductBySlug(slug!);

if (!product || product.status !== 'published') {
  return new Response(null, { status: 404, statusText: 'Article introuvable' });
}

const config = getSettings();

const outOfStock = product.trackStock && product.stock <= 0;
const lowStock = product.trackStock && product.stock > 0 && product.stock <= product.lowStockThreshold;
const canBuy = config.open && !outOfStock;

// Quelques articles du même rayon, pour poursuivre la visite.
const related = product.categoryId
  ? await listProducts({ categoryId: product.categoryId, status: 'published', perPage: 5 })
  : { rows: [] };
const others = related.rows.filter((p) => p.id !== product.id).slice(0, 4);

const cover = product.images[0];

const description = product.description
  ? truncate(product.description, 160)
  : `${product.name} — ${formatShort(product.price)} chez ${site.name} à ${site.city}. Le prix affiché est le prix payé.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description ?? description,
  sku: product.sku,
  ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
  ...(cover ? { image: new URL(imageUrl(cover.filename, cover.widths.at(-1) ?? 800), Astro.site).href } : {}),
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: 'XAF',
    availability: outOfStock
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/InStock',
    url: new URL(`/boutique/${product.slug}`, Astro.site).href,
    seller: { '@type': 'Organization', name: site.legalName },
  },
};
---

<BaseLayout title={product.name} description={description}
  solidHeader
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="section section--ivory shop-top">
    <div class="shell">
      <p style="margin:0 0 2rem;font-size:var(--step--1);color:var(--ink-muted)">
        <a href="/boutique" style="color:inherit">Boutique</a>
        {product.categoryName && (
          <>
            <span style="margin:0 0.5rem;color:var(--stone)">/</span>
            <a href={`/boutique?rayon=${product.categoryId}`} style="color:inherit">
              {product.categoryName}
            </a>
          </>
        )}
      </p>

      <div class="article-shop" data-product={product.id} data-min={product.minQuantity} data-max={product.trackStock ? product.stock : 9999}>
        <!-- Images -->
        <div>
          <div class="gallery__main">
            {
              cover ? (
                <img
                  id="vue"
                  src={imageUrl(cover.filename, cover.widths.at(-1) ?? 800)}
                  srcset={imageSrcset(cover.filename, cover.widths)}
                  sizes="(max-width: 880px) 100vw, 45vw"
                  alt={cover.alt ?? product.name}
                  width={cover.widths.at(-1)}
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <span class="good__empty" style="position:static;display:grid;height:100%">
                  photo à venir
                </span>
              )
            }
          </div>

          {
            product.images.length > 1 && (
              <div class="gallery__strip">
                {product.images.map((image, i) => (
                  <button
                    class:list={['gallery__thumb', { 'is-active': i === 0 }]}
                    type="button"
                    data-vue={imageUrl(image.filename, image.widths.at(-1) ?? 800)}
                    data-srcset={imageSrcset(image.filename, image.widths)}
                    aria-label={`Voir la photo ${i + 1}`}
                  >
                    <img
                      src={imageUrl(image.filename, image.widths[0])}
                      alt=""
                      width="68"
                      height="68"
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- Détail -->
        <div>
          {product.categoryName && <p class="detail__rayon">{product.categoryName}</p>}
          <h1 class="detail__title" data-reveal>{product.name}</h1>

          <div class="detail__price">
            <span class="detail__amount">{formatAmount(product.price)}</span>
            <span class="detail__currency">
              FCFA{product.unit !== 'pièce' ? ` / ${product.unit}` : ''}
            </span>
            {
              product.comparePrice && product.comparePrice > product.price && (
                <span class="good__was" style="font-size:var(--step-0)">
                  {formatAmount(product.comparePrice)}
                </span>
              )
            }
            <span class="detail__promise">
              <Icon name="check" size={14} />
              Ce prix est le prix payé. Rien ne s’y ajoute.
            </span>
          </div>

          {
            product.description && (
              <p class="body-copy" style="margin:0 0 1.25rem">{product.description}</p>
            )
          }

          {
            outOfStock ? (
              <div class="flash flash--info" style="margin-bottom:1.25rem">
                <Icon name="info" size={15} />
                <p>
                  <strong>Épuisé pour le moment.</strong> Le réapprovisionnement est en
                  cours. Appelez-nous pour connaître la date, ou pour être prévenue dès
                  son retour.
                </p>
              </div>
            ) : !config.open ? (
              <div class="flash flash--info" style="margin-bottom:1.25rem">
                <Icon name="info" size={15} />
                <p>{config.closedMessage}</p>
              </div>
            ) : null
          }

          {
            canBuy && (
              <>
                <div class="buy">
                  <div class="qty">
                    <button type="button" data-step="-1" aria-label="Diminuer la quantité">−</button>
                    <input
                      type="text"
                      inputmode="numeric"
                      value={String(product.minQuantity)}
                      data-qty
                      aria-label="Quantité"
                    />
                    <button type="button" data-step="1" aria-label="Augmenter la quantité">+</button>
                  </div>

                  <button class="btn" type="button" data-add>
                    Ajouter au panier
                    <Icon name="cart" size={15} />
                  </button>
                </div>

                <p class="buy-note">
                  {product.minQuantity > 1
                    ? `Vente par ${product.minQuantity} ${product.unit} minimum. `
                    : ''}
                  {lowStock
                    ? `Plus que ${product.stock} ${product.unit} en stock.`
                    : product.trackStock
                      ? `${product.stock} ${product.unit} disponibles aujourd’hui.`
                      : 'Disponible sur commande.'}
                </p>
              </>
            )
          }

          <div class="actions" style="margin-bottom:1.5rem">
            <Button
              href={`${site.whatsappHref}?text=${encodeURIComponent(`Bonjour, je suis intéressé par : ${product.name} (${product.sku}).`)}`}
              variant="outline"
              size="sm"
              arrow="whatsapp"
              external
            >
              Poser une question
            </Button>
            <Button href="/devis" variant="outline" size="sm">Commander en gros</Button>
          </div>

          <dl class="detail__meta">
            <dt>Référence</dt>
            <dd>{product.sku}</dd>

            <dt>Unité de vente</dt>
            <dd>{product.unit}</dd>

            {product.brand && (
              <>
                <dt>Marque</dt>
                <dd>{product.brand}</dd>
              </>
            )}

            {product.origin && (
              <>
                <dt>Origine</dt>
                <dd>{product.origin}</dd>
              </>
            )}

            {product.weightGrams && (
              <>
                <dt>Poids</dt>
                <dd>
                  {product.weightGrams >= 1000
                    ? `${(product.weightGrams / 1000).toFixed(product.weightGrams % 1000 === 0 ? 0 : 1).replace('.', ',')} kg`
                    : `${product.weightGrams} g`}
                </dd>
              </>
            )}

            <dt>Retrait</dt>
            <dd>{site.city}, {site.hoursShort}</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section">
        <div class="shell">
          <p class="eyebrow"><span>Dans le même rayon</span></p>
          <div class="goods" style="margin-top:1.75rem">
            {others.map((other) => (
              <a class="good" href={`/boutique/${other.slug}`}>
                <div class="good__frame">
                  {other.imageFilename ? (
                    <img
                      src={imageUrl(other.imageFilename, other.imageWidths?.[1] ?? other.imageWidths?.[0] ?? 400)}
                      srcset={imageSrcset(other.imageFilename, other.imageWidths ?? [400])}
                      sizes="(max-width: 640px) 50vw, 15rem"
                      alt={other.name}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="good__empty">photo à venir</span>
                  )}
                </div>
                <h3 class="good__name">{other.name}</h3>
                <div class="good__price">
                  <span class="good__amount">{formatAmount(other.price)}</span>
                  <span class="good__unit">FCFA</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script>
    import '../../scripts/shop';
  </script>
</BaseLayout>
