---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listProducts } from '../../lib/repo/products';
import { plural } from '../../lib/text';

// Les articles qui attendent encore une photo, les publiés d'abord.
const missing = await listProducts({ noImage: true, status: 'all', sort: 'name', perPage: 400 });
const published = missing.rows.filter((p) => p.status === 'published');
const drafts = missing.rows.filter((p) => p.status !== 'published');
---

<AdminLayout
  title="Photos en lot"
  subtitle="Déposez toutes les photos d’un coup : chacune rejoint son article d’après le nom du fichier"
>
  <div class="stack stack--loose">
    <!-- Dépôt -->
    <section class="card">
      <div class="card__body">
        <label class="drop" data-photo-drop>
          <input type="file" accept="image/*" multiple data-photo-input />
          <div class="drop__icon">
            <AdminIcon name="image" size={30} strokeWidth={1.3} />
          </div>
          <h3>Déposez vos photos ici</h3>
          <p>
            Autant de fichiers que vous voulez, d’un seul coup. Chaque photo est
            réduite sur votre appareil avant l’envoi — utile quand la connexion
            est lente — puis rangée toute seule.
          </p>
          <span class="btn btn--ghost btn--sm" style="margin-top:1rem">
            <AdminIcon name="image" size={14} />
            Choisir des photos
          </span>
        </label>

        <div class="note note--info" style="margin-top:1.125rem">
          <AdminIcon name="info" size={15} />
          <p>
            <strong>Nommez les fichiers avec la référence de l’article.</strong>
            <code>RIZ-25KG.jpg</code> devient la photo de l’article RIZ-25KG.
            Pour plusieurs vues du même article, ajoutez un numéro :
            <code>RIZ-25KG-2.jpg</code>, <code>RIZ-25KG-3.jpg</code>.
            La photo numéro 1 est celle qui s’affiche en vitrine.
          </p>
        </div>
      </div>

      <div data-photo-progress style="display:none">
        <div class="card__foot" style="display:block">
          <div class="bar">
            <div class="bar__fill" data-photo-bar style="width:0%"></div>
          </div>
          <p
            style="margin:0.5rem 0 0;font-size:0.8125rem;color:var(--a-ink-muted);font-variant-numeric:tabular-nums"
            data-photo-text
          >
            Préparation…
          </p>
        </div>
      </div>
    </section>

    <!-- Résultats -->
    <section class="card" data-photo-results style="display:none">
      <div class="card__head">
        <div style="flex:1">
          <h2>Photos déposées</h2>
          <p data-photo-summary></p>
        </div>
        <button class="btn btn--ghost btn--sm" type="button" data-photo-reload>
          <AdminIcon name="refresh" size={14} />
          Actualiser la liste
        </button>
      </div>
      <div class="rows" data-photo-list></div>
    </section>

    <!-- Articles sans photo -->
    <section class="card">
      <div class="card__head">
        <div style="flex:1">
          <h2>Articles sans photo</h2>
          <p>
            {missing.total === 0
              ? 'Tous les articles ont au moins une photo.'
              : `${plural(missing.total, 'article attend', 'articles attendent')} une photo.`}
          </p>
        </div>
        {
          missing.total > 0 && (
            <button class="btn btn--ghost btn--sm" type="button" data-copy-skus>
              <AdminIcon name="copy" size={14} />
              Copier les références
            </button>
          )
        }
      </div>

      {
        missing.total === 0 ? (
          <div class="empty" style="padding:2rem 1rem">
            <h3>Rien à photographier</h3>
            <p>Chaque article du catalogue a sa photo.</p>
          </div>
        ) : (
          <div class="card__body">
            {published.length > 0 && (
              <>
                <p class="section-label">
                  En ligne sans photo — {published.length} article{published.length > 1 ? 's' : ''}
                </p>
                <div class="note note--warning" style="margin-bottom:0.875rem">
                  <AdminIcon name="alert" size={15} />
                  <p>
                    Ces articles sont déjà en vitrine mais sans image. Un article sans
                    photo se vend mal.
                  </p>
                </div>
                <ul class="sku-list">
                  {published.map((p) => (
                    <li>
                      <a href={`/admin/produits/${p.id}`}>
                        <strong>{p.sku}</strong>
                        <span>{p.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {drafts.length > 0 && (
              <>
                <p class="section-label" style={published.length ? 'margin-top:1.5rem' : ''}>
                  Brouillons — {drafts.length} article{drafts.length > 1 ? 's' : ''}
                </p>
                <ul class="sku-list">
                  {drafts.map((p) => (
                    <li>
                      <a href={`/admin/produits/${p.id}`}>
                        <strong>{p.sku}</strong>
                        <span>{p.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {missing.total > missing.rows.length && (
              <p style="margin:1rem 0 0;font-size:0.8125rem;color:var(--a-ink-muted)">
                {missing.rows.length} références affichées sur {missing.total}.
              </p>
            )}
          </div>
        )
      }
    </section>
  </div>

  <textarea
    data-skus
    aria-hidden="true"
    tabindex="-1"
    style="position:absolute;left:-9999px;top:0;opacity:0"
    set:text={missing.rows.map((p) => p.sku).join('\n')}
  />

  <style>
    .sku-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 1px;
      background: var(--a-hair-soft);
      border: 1px solid var(--a-hair-soft);
      border-radius: var(--a-radius);
      overflow: hidden;
    }

    .sku-list a {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.4375rem 0.625rem;
      background: var(--a-paper);
      text-decoration: none;
      font-size: 0.8125rem;
      min-width: 0;
    }

    .sku-list a:hover { background: var(--a-gold-wash); }

    .sku-list strong {
      font-variant-numeric: tabular-nums;
      font-size: 0.75rem;
      color: var(--a-gold-deep);
      white-space: nowrap;
    }

    .sku-list span {
      color: var(--a-ink-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Pas de troisième famille : Arimo, resserrée, suffit à faire
       lire un nom de fichier comme un nom de fichier. */
    code {
      font-family: var(--a-font);
      font-size: 0.875em;
      font-weight: 600;
      letter-spacing: 0.02em;
      background: rgba(11, 21, 38, 0.06);
      padding: 0.0625rem 0.3125rem;
      border-radius: 3px;
      white-space: nowrap;
    }

    .shot {
      width: 34px;
      height: 34px;
      border-radius: 3px;
      object-fit: cover;
      flex: none;
      background: var(--a-ivory-soft);
    }
  </style>

  <script>
    import '../../scripts/admin-photos';
  </script>
</AdminLayout>
