---
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { divisions } from '../data/divisions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  titleSuffix?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og.jpg',
  bodyClass = '',
  titleSuffix = true,
} = Astro.props;

const pageTitle = titleSuffix ? `${title} | ${site.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const logoUrl = new URL('/icon-512.png', Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: Astro.site?.href,
  logo: logoUrl.href,
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bafoussam',
    addressRegion: "Région de l'Ouest",
    addressCountry: 'CM',
  },
  email: site.email,
  telephone: site.phoneDisplay,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phoneDisplay,
    contactType: 'service client',
    availableLanguage: ['fr', 'en'],
  },
  areaServed: {
    '@type': 'Country',
    name: 'Cameroun',
  },
  knowsAbout: divisions.map((division) => division.name),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0B1526" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/arimo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-serif-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-serif-400-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${site.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
